# Include inside nginx's http context. Replace hostname and certificate paths.
# The certificate must already exist; its renewal is a host setup responsibility.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name callbacks.example.net;
    ssl_certificate /etc/letsencrypt/live/callbacks.example.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/callbacks.example.net/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Provider payloads can contain personal information. Do not enable debug logs,
    # request capture or body mirroring. Application errors are recorded separately.
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 64k;
    client_body_buffer_size 64k;
    client_body_timeout 15s;

    location = /v1/external/smtp2go/events {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8582;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
    }
    location / { return 404; }
}
