+#[test]
+fn audit_stale_followup_should_have_message_validity_error() {
+    let mut f=Fixture::new();
+    f.open();
+    f.execute(ActorRef::Recipient(ProtocolIdentity(20)), ProtocolCommand::SetFollowupPolicy {
+        expected_version:Version(0), policy:FollowupPolicy {version:Version(0),max_messages:3,max_per_interval:3,interval:Duration(20)}
+    },4).unwrap();
+    let result=f.sender(ProtocolCommand::AdmitFollowup {
+        request_id:RequestId(1),message_id:MessageId(2),content_ref:ContentRef(2),delivery_intent_ref:DeliveryIntentRef(2),
+        declaration_digest:MessageDeclarationDigest([0;32]),message_valid_until:MessageValidityUntil(CanonicalTime(5)),expected_policy_version:Version(1)
+    },6);
+    assert!(format!("{result:?}").contains("MessageValidityClosed"), "an open request with deadline 53 is reported as: {result:?}");
+}
